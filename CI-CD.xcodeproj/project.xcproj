{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "fr",
      "nl",
      "ru",
      "tr",
      "uk",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/onevcat/Kingfisher",
      "version": {
        "up-to-next-major-version": "8.3.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/AvdLee/appstoreconnect-swift-sdk",
      "version": {
        "up-to-next-major-version": "4.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/MailCover",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/SafariCover",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/Appearance",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    {
      "kind": "folder",
      "path": "CI-CD",
      "target-membership": [
        "iOS",
        "visionOS",
      ],
      "membership-exceptions": [
        {
          "target": "iOS",
          "exclusions": [
            "iOS.plist",
          ],
        }, {
          "target": "visionOS",
          "exclusions": [
            "AppIcon.icon",
            "Localizable.xcstrings",
            "iOS.plist",
          ],
        }, {
          "target": "macOS",
          "inclusions": [
            "AppIcon.icon",
            "Assets.xcassets",
            "Utils/HomeViewTab.swift",
          ],
        }, {
          "target": "Unit Tests",
          "inclusions": [
            "Coolify/Models/CoolifyDatabase.swift",
            "Coolify/Models/CoolifyDeployment.swift",
            "Coolify/Models/CoolifyProject.swift",
            "Coolify/Models/CoolifyProjectEnv.swift",
            "Utils/CoolifyAPIEndpoint.swift",
            "Utils/HomeViewTab.swift",
            "Utils/ValueStore.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "visionOS",
      "membership-exceptions": [
        {
          "target": "visionOS",
          "inclusions": [
            "Assets.xcassets",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "macOS", "target-membership": [ "macOS" ] },
    { "kind": "folder", "path": "Unit Tests", "target-membership": [ "Unit Tests" ] },
    { "path": "LICENSE.txt" },
    { "kind": "group", "name": "Frameworks" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/iOS.app", "id": "F337089F2DD93A01006834F8", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/visionOS.app", "id": "F32429E72DDDD018000A16E8", "type": "wrapper.application", "index": false },
